<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meu CEUB Digital - Agenda Acadêmica"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1) Cadastrar disciplina"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNomeDisciplina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome da disciplina"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtProfessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Professor"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSalvarDisciplina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar disciplina" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2) Cadastrar tarefa"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/edtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título da tarefa"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtPrazo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prazo (ex: 30/11/2026)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSalvarTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar tarefa" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3) Tarefas cadastradas (INNER JOIN)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTarefas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
